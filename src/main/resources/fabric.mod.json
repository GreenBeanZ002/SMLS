{
  "schemaVersion": 1,
  "id": "smls",
  "version": "${version}",
  "name": "Stoneworks Mod for Lazy Staff",
  "description": "A mod made for the LAZY staff of stoneworks",
  "authors": ["GreenBeanZ_", "Siaffs", "GreenBeanz_"],
  "contact": {
    "issues": "https://github.com/GreenBeanZ_/SMLS/issues",
    "sources": "https://github.com/GreenBeanZ_/SMLS"
  },
  "license": "MIT",
  "icon": "assets/SMLS/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.greenbeanz.client.SMLSClient"
    ],
    "modmenu": [
      "com.greenbeanz.client.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "smls.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=26.3- <26.4",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
